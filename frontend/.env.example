# Frontend settings. start.sh copies this to frontend/.env on first run; on a hosting
# platform (Vercel, Netlify, …), set VITE_API_URL in the project's environment instead.

# Address of the backend, for example https://ieftin.firewifi.online. It is built into
# the page. Leave empty when the backend serves the same address as the page, which is
# the case in development: the dev server forwards /api to the backend itself.
VITE_API_URL=

# Development only: the dev server's port and the backend it forwards /api to.
# FRONTEND_PORT=5180
# BACKEND_URL=http://127.0.0.1:8090
