# Copied to .env by start.sh on first run.
POSTGRES_USER=ieftin
POSTGRES_PASSWORD=ieftin
POSTGRES_DB=ieftin
POSTGRES_PORT=5544
DATABASE_URL=postgres://ieftin:ieftin@127.0.0.1:5544/ieftin

BIND_ADDR=127.0.0.1:8090
FRONTEND_PORT=5180

# Crawler: each healthy store is fully re-crawled on this interval.
CRAWL_ENABLED=true
CRAWL_INTERVAL_HOURS=24
# Minimum pause between two requests to the same store.
CRAWL_DELAY_MS=300
