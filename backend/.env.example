# Backend settings. start.sh copies this to backend/.env on first run; on a hosting
# platform, set the same names as environment variables instead.
#
# Only DATABASE_URL is required. Everything else has a default that suits both local
# development and a platform that provides PORT.

# PostgreSQL. Locally this is the database from docker-compose.yml: start.sh starts it
# on the port given here.
DATABASE_URL=postgres://ieftin:ieftin@127.0.0.1:5544/ieftin

# Where to listen. Leave unset to use the platform's PORT on every interface, or
# 127.0.0.1:8090 when there is no PORT (local development).
# BIND_ADDR=127.0.0.1:8090

# Websites allowed to call the API from a browser, comma-separated, for example
# https://ieftin.vercel.app. Unset: any website may, which is safe because the API
# is public, read-only and uses no cookies.
# CORS_ORIGINS=

# Crawler: each healthy store is fully re-crawled on this interval.
# CRAWL_ENABLED=true
# CRAWL_INTERVAL_HOURS=24
# Minimum pause between two requests to the same store.
# CRAWL_DELAY_MS=300
